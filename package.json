{
  "name": "mikrotik-traffic-control",
  "version": "1.1.0",
  "description": "Live traffic monitoring, usage quotas, bandwidth control, guest Wi-Fi and security alerts for MikroTik RouterOS networks. Multi-language (en, fa, ar, ru, zh).",
  "license": "MIT",
  "author": "Mehdi Mahdian (https://github.com/mehdimahdian)",
