  "private": false,
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node src/manager.js",
    "demo": "node test/demo.js",
    "test": "node --test test/*.test.js",
    "build:rsc": "node tools/build-rsc.js",
    "build:release": "pwsh -NoProfile -File windows/build-release.ps1",
    "lint": "node tools/check-syntax.js",
    "i18n:check": "node tools/i18n-check.js"
  },
  "keywords": [
    "mikrotik",
