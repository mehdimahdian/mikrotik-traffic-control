# Mikrotik Traffic Control - base setup (example)
# Generated by Mikrotik Traffic Control (https://kish-it.com). Review it, then paste it into a RouterOS terminal or upload it and run  /import file-name=<name>.rsc
# Every object carries a comment starting with "[mtc-" so it can be found and removed (see mtc-remove.rsc).
# EXAMPLE: internet interface = ether1 (change it to yours), guest network on ether5 = 10.77.0.1/24 (change interface and address). Delete the sections you do not want.
# Take a backup first:  /export file=before-mtc

# filter forward: drop traffic of list MTC-Blocked-Clients to the internet (ether1); the list starts empty, nobody is blocked
:if ([:len [/ip firewall filter find where comment="\5Bmtc-block\5D Blocked clients (list MTC-Blocked-Clients) -> internet: drop (manual block from Mikrotik Traffic Control; LAN access unaffected)"]] = 0) do={ /ip firewall filter add chain=forward action=drop src-address-list=MTC-Blocked-Clients out-interface=ether1 comment="\5Bmtc-block\5D Blocked clients (list MTC-Blocked-Clients) -> internet: drop (manual block from Mikrotik Traffic Control; LAN access unaffected)" place-before=0 }
# raw prerouting: drop everything from list MTC-Blocked-IPs arriving on ether1
:if ([:len [/ip firewall raw find where comment="\5Bmtc-ipblock\5D Internet -> router/LAN: drop everything from blocked addresses (list MTC-Blocked-IPs)"]] = 0) do={ /ip firewall raw add chain=prerouting action=drop src-address-list=MTC-Blocked-IPs in-interface=ether1 comment="\5Bmtc-ipblock\5D Internet -> router/LAN: drop everything from blocked addresses (list MTC-Blocked-IPs)" place-before=0 }
# raw prerouting: LAN devices cannot talk to addresses in list MTC-Blocked-IPs
:if ([:len [/ip firewall raw find where comment="\5Bmtc-ipblock\5D LAN -> blocked internet addresses (list MTC-Blocked-IPs): drop"]] = 0) do={ /ip firewall raw add chain=prerouting action=drop dst-address-list=MTC-Blocked-IPs in-interface=!ether1 comment="\5Bmtc-ipblock\5D LAN -> blocked internet addresses (list MTC-Blocked-IPs): drop" place-before=0 }
# address 10.77.0.1/24 on ether5 (guest network 10.77.0.0/24)
:do { /ip address add address=10.77.0.1/24 interface=ether5 comment="\5Bmtc-guest\5D guest network gateway" } on-error={ :put "skipped (already done or not possible)" }
# address pool mtc-guest-pool 10.77.0.10-10.77.0.254
:do { /ip pool add name=mtc-guest-pool ranges=10.77.0.10-10.77.0.254 comment="\5Bmtc-guest\5D guest DHCP pool" } on-error={ :put "skipped (already done or not possible)" }
# DHCP network 10.77.0.0/24 gateway 10.77.0.1 dns 10.77.0.1
:do { /ip dhcp-server network add address=10.77.0.0/24 gateway=10.77.0.1 dns-server=10.77.0.1 comment="\5Bmtc-guest\5D guest DHCP network" } on-error={ :put "skipped (already done or not possible)" }
# DHCP server mtc-guest-dhcp on ether5, lease 1h
:do { /ip dhcp-server add name=mtc-guest-dhcp interface=ether5 address-pool=mtc-guest-pool lease-time=1h disabled=no comment="\5Bmtc-guest\5D guest DHCP server" } on-error={ :put "skipped (already done or not possible)" }
# NAT masquerade for 10.77.0.0/24 out ether1
:if ([:len [/ip firewall nat find where comment="\5Bmtc-guest\5D guest network -> internet (NAT)"]] = 0) do={ /ip firewall nat add chain=srcnat action=masquerade src-address=10.77.0.0/24 out-interface=ether1 comment="\5Bmtc-guest\5D guest network -> internet (NAT)" }
# address list mtc-private: 10.0.0.0/8
:if ([:len [/ip firewall address-list find where address=10.0.0.0/8 list=mtc-private]] = 0) do={ /ip firewall address-list add list=mtc-private address=10.0.0.0/8 comment="\5Bmtc-guest\5D private networks (guests must not reach them)" }
# address list mtc-private: 172.16.0.0/12
:if ([:len [/ip firewall address-list find where address=172.16.0.0/12 list=mtc-private]] = 0) do={ /ip firewall address-list add list=mtc-private address=172.16.0.0/12 comment="\5Bmtc-guest\5D private networks (guests must not reach them)" }
# address list mtc-private: 192.168.0.0/16
:if ([:len [/ip firewall address-list find where address=192.168.0.0/16 list=mtc-private]] = 0) do={ /ip firewall address-list add list=mtc-private address=192.168.0.0/16 comment="\5Bmtc-guest\5D private networks (guests must not reach them)" }
# filter forward: guests (10.77.0.0/24) cannot open connections to private networks (internet and the router's hotspot/DNS stay available)
:if ([:len [/ip firewall filter find where comment="\5Bmtc-guest\5D guests -> private networks: drop"]] = 0) do={ /ip firewall filter add chain=forward action=drop src-address=10.77.0.0/24 dst-address-list=mtc-private comment="\5Bmtc-guest\5D guests -> private networks: drop" place-before=0 }
# filter input: guests (10.77.0.0/24) can reach the router only for DNS and DHCP (everything else dropped; the hotspot login page keeps working)
:if ([:len [/ip firewall filter find where comment="\5Bmtc-guest\5D guests -> router: drop (DNS/DHCP allowed above)"]] = 0) do={ /ip firewall filter add chain=input action=drop src-address=10.77.0.0/24 comment="\5Bmtc-guest\5D guests -> router: drop (DNS/DHCP allowed above)" place-before=0 }
# filter input: guests (10.77.0.0/24) -> router DNS (udp/tcp 53) and DHCP (udp 67) accepted
:if ([:len [/ip firewall filter find where comment="\5Bmtc-guest\5D guests -> router: DNS and DHCP accept"]] = 0) do={ /ip firewall filter add chain=input action=accept src-address=10.77.0.0/24 protocol=udp dst-port=53,67 comment="\5Bmtc-guest\5D guests -> router: DNS and DHCP accept" place-before=0 }

# FastTrack: rules with action=fasttrack-connection bypass speed limits. Disable them (they are not deleted):
/ip firewall filter disable [find where action=fasttrack-connection]
